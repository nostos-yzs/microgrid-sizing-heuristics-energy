+def _map_to_bounds(physical_action: np.ndarray, bounds: dict) -> np.ndarray:
+    """Agent returns physical [k,p]; validate/clip ONLY, never affine-map again."""
+    a = np.asarray(physical_action, dtype=float)
+    lo = np.array([bounds[k][0] for k in ["gamma_fb", "diag_prob"]])
+    hi = np.array([bounds[k][1] for k in ["gamma_fb", "diag_prob"]])
+    if a.shape != (2,) or not np.isfinite(a).all():
+        raise ValueError("invalid physical action")
+    return np.clip(a, lo, hi)
 
 
